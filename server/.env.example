# Copy to .env and fill in. Never commit .env.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
# Tried in order when the main model is unavailable, slow or out of quota.
LLM_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.7-flash
# Per-model timeout in seconds.
LLM_TIMEOUT_S=30
GEMINI_API_KEY=your-key-here
CACHE_PATH=cache.sqlite3
