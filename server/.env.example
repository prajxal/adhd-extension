# Copy to .env and fill in. Never commit .env.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
# Tried in order when the main model is unavailable, slow or out of quota.
LLM_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.7-flash
# Per-model timeout in seconds.
LLM_TIMEOUT_S=30
GEMINI_API_KEY=your-key-here
CACHE_PATH=cache.sqlite3
# Meaning check: llm (judge + rules), rules (no extra LLM call) or off.
MEANING_CHECK=llm
# Auto-repair sentences the meaning check marks as problems (needs MEANING_CHECK=llm): on or off.
MEANING_REPAIR=on
# --- Production (set on Render; see render.yaml). Leave unset for local development. ---
# APP_ENV=production
# ALLOWED_EXTENSION_IDS=your-extension-id
# RATE_LIMIT_PER_MINUTE=20
# RATE_LIMIT_PER_DAY=200
# DAILY_AI_CALL_LIMIT=500
# CACHE_TTL_HOURS=24
# PRIVACY_CONTACT=you@example.com
